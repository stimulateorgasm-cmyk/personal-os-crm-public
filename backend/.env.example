# ─── Personal OS CRM — переменные окружения (пример) ──────────────────────────
# Скопируйте в .env и заполните реальными значениями.

# Режим БД: true = PostgreSQL (prod), пусто = SQLite (dev)
USE_PG=true
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/personal_os

# Notion (клиенты, сделки)
NOTION_API_KEY=
NOTION_CLIENTS_DB_ID=
NOTION_DEALS_DB_ID=

# Kaiten (задачи)
KAITEN_API_KEY=
KAITEN_DOMAIN=shumkin.kaiten.ru
KAITEN_SPACE_ID=

# Telegram-боты (уведомления, квизы)
NOTIFY_BOT_TOKEN=
ASSISTANT_CHAT_ID=
ANTON_CHAT_ID=
TONYROAR_CHAT_ID=
QUIZ_BOT_TOKEN=
MENS_BOT_TOKEN=

# Telegram Sender (Telethon, личка)
TELEGRAM_SENDER_URL=http://127.0.0.1:8011
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
ASSISTANT_TELEGRAM_PHONE=

# Шлюзы агентов / LLM
GATEWAY_URL=
GATEWAY_SECRET=
MIRA_API_URL=http://127.0.0.1:8081/api/chat
DEEPSEEK_API_KEY=
LITELLM_URL=http://127.0.0.1:8080/chat/completions

# Прочее
CHITKOD_TOPIC_ID=0
ALLOWED_ORIGINS=

# ─── Реклама: синк метрик площадок (Фаза 3d, по кнопке) ──────────────────────
# Apify (аккаунт MOLVA, план FREE)
APIFY_TOKEN=
# Бот-админ канала «Состояние Шумкина» (для getChatMemberCount)
TELEGRAM_BOT_TOKEN=
# @username или chat_id канала «Состояние Шумкина»
STATE_OF_SHUMKIN_CHANNEL=
# URL YouTube-канала (https://www.youtube.com/@...) для streamers/youtube-scraper
YOUTUBE_CHANNEL_URL=
